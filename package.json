{
  "name": "claude-glass",
  "version": "1.0.0",
  "description": "Glassmorphism desktop widget for monitoring Claude usage on Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:parity && npm run test:smoke",
    "test:parity": "node test/bridge-parity.js",
    "test:smoke": "node test/smoke/run.js",
    "dist:win": "npx electron-builder --win zip"
  },
  "author": "Vitória Silva — Data System",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.datasystem.claude-glass",
    "productName": "Claude Glass",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "usage.js",
      "auth.js",
      "config.json",
      "renderer/**"
    ],
    "win": {
      "target": "zip"
    }
  }
}
